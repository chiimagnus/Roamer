expression -l objc++ -- @import Foundation; @import ObjectiveC;
expression -l objc++ -O -- ({ Class wrapperClass = NSClassFromString(@"libViewDebuggerSupport.SpatialSceneDebugRepresentationWrapper"); NSArray *scenes = [(id)wrapperClass performSelector:NSSelectorFromString(@"fallback_debugHierarchyObjectsInGroupWithID:outOptions:") withObject:@"com.apple.visionOS.Scene" withObject:nil]; SEL selector = NSSelectorFromString(@"fallback_debugHierarchyValueForPropertyWithName:onObject:outOptions:outError:"); id (*getter)(id, SEL, id, id, id *, id *) = (id (*)(id, SEL, id, id, id *, id *))method_getImplementation(class_getClassMethod(wrapperClass, selector)); NSMutableArray *results = [NSMutableArray array]; for (NSUInteger index = 0; index < [scenes count]; index++) { id options = nil; id error = nil; id data = getter((id)wrapperClass, selector, @"sceneDebugRepresentation", scenes[index], &options, &error); NSString *path = [NSTemporaryDirectory() stringByAppendingPathComponent:[NSString stringWithFormat:@"roamer-native-scene-%@-%lu.data", [[NSUUID UUID] UUIDString], (unsigned long)index]]; BOOL written = [(NSObject *)data isKindOfClass:[NSData class]] && [(NSData *)data writeToFile:path atomically:YES]; [results addObject:@[@(index), @(written), path, options ?: [NSNull null], error ?: [NSNull null]]]; } results; })
