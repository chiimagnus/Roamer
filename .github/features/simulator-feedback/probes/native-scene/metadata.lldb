expression -l objc++ -O -- (void *)dlopen("/usr/lib/libViewDebuggerSupport.dylib", 2)
expression -l objc++ -- @import Foundation; @import ObjectiveC;
expression -l objc++ -O -- ({ NSMutableString *output = [NSMutableString string]; for (NSString *name in @[@"libViewDebuggerSupport.SpatialSceneDebugRepresentationWrapper", @"DebugHierarchyTargetHub", @"DebugHierarchyRequest"]) { Class nativeClass = NSClassFromString(name); [output appendFormat:@"CLASS %@ %p\n", name, nativeClass]; for (int kind = 0; kind < 2; kind++) { unsigned count = 0; Method *methods = class_copyMethodList(kind ? object_getClass(nativeClass) : nativeClass, &count); for (unsigned index = 0; index < count; index++) [output appendFormat:@"%d %s %s\n", kind, sel_getName(method_getName(methods[index])), method_getTypeEncoding(methods[index])]; free(methods); }} output; })
image lookup -rn 'RE.*(Debug.*(Axes|Bounds|Visual)|Visualiz|Scene.*Debug)|(RealityKit|RealityFoundation).*(debugOptions|debugVisualization)'
